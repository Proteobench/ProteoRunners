manifest {
    name            = 'ProteoRunners'
    author          = 'rodvrees'
    homePage        = 'https://github.com/ProteoBench/ProteoRunners'
    description     = 'Nextflow pipeline running DIA-NN, AlphaDIA, Sage, FragPipe, MaxQuant, and MetaMorpheus on ProteoBench benchmark datasets.'
    mainScript      = 'proteobench.nf'
    defaultBranch   = 'main'
    // The scripts use Nextflow's strict syntax, which also parses under the
    // legacy parser (NXF_SYNTAX_PARSER=v1). Tested with 26.04.6 on both parsers.
    nextflowVersion = '>=23.10'
    version         = '1.0.4'
}

// ─── Parameters ──────────────────────────────────────────────────────────────
// Defaults for every --flag of proteobench.nf and setup.nf, in one place. The
// scripts repeat these defaults so they document themselves; keep both in sync.
// Values given on the command line always take precedence.

// Pipeline configuration (tools, datasets, search parameters).
params.config = "${projectDir}/config.yaml"

// proteobench.nf
params.tool               = null    // restrict to one tool (e.g. --tool diann)
params.dataset            = null    // restrict to one dataset
params.no_preflight       = false   // skip preflight checks
params.unfiltered_outputs = false   // keep full raw tool outputs; default filters down to ProteoBench upload files

// Number of tool runs at the same time. Default: global.max_parallel_jobs in
// config.yaml, or 6 if it is not set there.
params.max_parallel_jobs = new File(params.config.toString()).with { f ->
    def cfg = f.exists() ? new org.yaml.snakeyaml.Yaml().load(f.text) : null
    (cfg instanceof Map && cfg.global instanceof Map && cfg.global.max_parallel_jobs) ? cfg.global.max_parallel_jobs : 6
}

// Where run_summary_nf.tsv is published. Default: global.output_dir in
// config.yaml (relative paths are relative to config.yaml), or
// ${projectDir}/results while output_dir is unset or still CHANGE_ME.
params.publish_dir = new File(params.config.toString()).with { f ->
    def cfg = f.exists() ? new org.yaml.snakeyaml.Yaml().load(f.text) : null
    def od = (cfg instanceof Map && cfg.global instanceof Map) ? cfg.global.output_dir?.toString() : null
    (!od || od.contains('CHANGE_ME')) ? null : (new File(od).isAbsolute() ? od : new File(f.absoluteFile.parentFile, od).path)
}

// setup.nf (docker setup wizard; run automatically by proteobench.nf when needed)
params.non_interactive   = false    // never prompt; use the defaults and the flags below
params.skip_fragpipe     = false
params.msfragger_path    = null     // path to a MSFragger .zip or extracted folder
params.ionquant_path     = null     // path to an IonQuant .zip or extracted folder
params.diatracer_path    = null     // path to a diaTracer .zip or extracted folder
params.diann_version     = '2.5.0'  // DIA-NN 2.x version(s) to build locally, comma-separated
params.build_diann_v2    = false    // non-interactive opt-in to build the DIA-NN 2.x image(s)
params.alphadia_gpu      = false
params.skip_datasets     = false
params.data_dir          = null     // where downloaded datasets go; default: ${projectDir}/data
params.download_datasets = null     // "all", or a comma-separated list of dataset names
params.selftest          = false    // `nextflow run setup.nf --selftest`: check the setup helpers
